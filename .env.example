NOOSFERA_ENV=local
NOOSFERA_NODE_ID=node-local-development
NOOSFERA_LOG_LEVEL=INFO
NOOSFERA_DATABASE_URL=postgresql://noosfera:noosfera@postgres:5432/noosfera
NOOSFERA_NATS_URL=nats://localhost:4222
NOOSFERA_OBJECT_STORE_ENDPOINT=http://localhost:9000
NOOSFERA_OBJECT_STORE_BUCKET=noosfera-evidence
NOOSFERA_OPA_URL=http://localhost:8181
NOOSFERA_OTLP_ENDPOINT=http://localhost:4317
NOOSFERA_SIGNING_KEY_REF=local-development-only
NOOSFERA_STORAGE_BACKEND=postgres
NOOSFERA_EVENT_BACKEND=nats
NOOSFERA_GOVERNANCE_BACKEND=opa
NOOSFERA_EXECUTION_BACKEND=rust
NOOSFERA_EXECUTION_URL=http://execution-service:8080
NOOSFERA_MODEL_PROVIDER=ollama
NOOSFERA_MODEL_BASE_URL=http://ollama:11434
NOOSFERA_MODEL_NAME=qwen3:8b
NOOSFERA_MODEL_ALLOW_REMOTE=false
NOOSFERA_MODEL_TIMEOUT_SECONDS=120
NOOSFERA_MODEL_MAX_INPUT_CHARS=200000
NOOSFERA_MODEL_CONTEXT_TOKENS=32768
NOOSFERA_MODEL_OUTPUT_TOKENS=4096
NOOSFERA_MAX_DOCUMENT_BYTES=5000000
NOOSFERA_MAX_OUTPUT_BYTES=250000
NOOSFERA_LOCAL_USERNAME=sheily
NOOSFERA_LOCAL_PASSWORD=change-me-local
NOOSFERA_TOKEN_SECRET=local-token-secret-change-me-32-characters
NOOSFERA_CAPABILITY_SECRET=local-capability-secret-change-me-32-chars
NOOSFERA_TOKEN_TTL_SECONDS=3600
NOOSFERA_CORS_ORIGINS=http://localhost:3001,http://localhost:3002
