{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noosfera.invalid/schemas/agent-mission.schema.json",
  "title": "AgentMission",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "user_id", "conversation_id", "prompt", "document_ids", "remember", "status", "version", "created_at", "updated_at"],
  "properties": {
    "id": {"$ref": "common.schema.json#/$defs/urn"},
    "user_id": {"$ref": "common.schema.json#/$defs/urn"},
    "conversation_id": {"$ref": "common.schema.json#/$defs/urn"},
    "prompt": {"type": "string", "minLength": 1, "maxLength": 20000},
    "document_ids": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/urn"}},
    "remember": {"type": "boolean"},
    "status": {"enum": ["received", "planning", "awaiting-approval", "authorized", "executing", "verifying", "completed", "rejected", "failed", "stopped"]},
    "plan": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["objective", "tool", "operation", "resource", "steps", "success_criteria", "risk_factors", "requires_documents"],
          "properties": {
            "objective": {"type": "string", "minLength": 1, "maxLength": 2000},
            "tool": {"enum": ["conversation.answer", "document.report"]},
            "operation": {"enum": ["answer", "generate"]},
            "resource": {"enum": ["urn:noosfera:tool:conversation-answer", "urn:noosfera:tool:document-report"]},
            "steps": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "object", "additionalProperties": false, "required": ["index", "description"], "properties": {"index": {"type": "integer", "minimum": 1}, "description": {"type": "string", "minLength": 1, "maxLength": 500}}}},
            "success_criteria": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "string"}},
            "risk_factors": {"type": "array", "maxItems": 10, "items": {"type": "string"}},
            "requires_documents": {"type": "boolean"}
          }
        }
      ],
      "default": null
    },
    "plan_hash": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/sha256"}]},
    "risk": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["risk_class", "score", "requires_approval", "reasons"],
          "properties": {
            "risk_class": {"enum": ["R0", "R1", "R2", "R3", "R4", "R5"]},
            "score": {"type": "number", "minimum": 0, "maximum": 1},
            "requires_approval": {"type": "boolean"},
            "reasons": {"type": "array", "items": {"type": "string"}}
          }
        }
      ]
    },
    "capability_id": {"type": ["string", "null"]},
    "result": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["answer", "citations"],
          "properties": {
            "answer": {"type": "string", "minLength": 1, "maxLength": 100000},
            "citations": {"type": "array", "maxItems": 100, "items": {"type": "object", "additionalProperties": false, "required": ["document_id", "label"], "properties": {"document_id": {"$ref": "common.schema.json#/$defs/urn"}, "label": {"type": "string"}}}}
          }
        }
      ]
    },
    "error": {"type": ["string", "null"], "maxLength": 1000},
    "version": {"type": "integer", "minimum": 1},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "updated_at": {"$ref": "common.schema.json#/$defs/timestamp"}
  }
}
