{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noosfera.invalid/schemas/mission-event.schema.json",
  "title": "MissionEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["mission_id", "sequence", "event_type", "payload", "event_hash", "previous_receipt_hash", "receipt_hash", "created_at"],
  "properties": {
    "mission_id": {"$ref": "common.schema.json#/$defs/urn"},
    "sequence": {"type": "integer", "minimum": 1},
    "event_type": {"type": "string", "pattern": "^[a-z][a-z0-9.-]+$"},
    "payload": {"type": "object"},
    "event_hash": {"$ref": "common.schema.json#/$defs/sha256"},
    "previous_receipt_hash": {"$ref": "common.schema.json#/$defs/sha256"},
    "receipt_hash": {"$ref": "common.schema.json#/$defs/sha256"},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"}
  }
}
