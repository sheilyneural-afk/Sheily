{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noosfera.invalid/schemas/service-manifest.schema.json",
  "title": "ServiceManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "family", "version", "runtime", "modules", "inbound_buses", "outbound_buses", "data_stores", "health", "slo", "runbook", "owner", "deny_by_default"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+-service$"},
    "family": {"pattern": "^[A-Z]{3}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "runtime": {"enum": ["python", "rust", "typescript"]},
    "target_runtime": {"enum": ["python", "rust", "typescript"]},
    "modules": {"type": "array", "items": {"pattern": "^[A-Z]{3}-[0-9]{2}$"}, "minItems": 1, "uniqueItems": true},
    "providers": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "modules", "endpoint", "methods", "maturity", "capabilities", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]+$"},
          "modules": {"type": "array", "items": {"pattern": "^[A-Z]{3}-[0-9]{2}$"}, "minItems": 1, "uniqueItems": true},
          "endpoint": {"type": "string", "pattern": "^/"},
          "methods": {
            "type": "array",
            "items": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]},
            "minItems": 1,
            "uniqueItems": true
          },
          "maturity": {"enum": ["implemented", "integrated", "verified", "production-ready"]},
          "capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
          "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true}
        }
      }
    },
    "inbound_buses": {"type": "array", "items": {"pattern": "^BUS-[A-Z]{3}$"}},
    "outbound_buses": {"type": "array", "items": {"pattern": "^BUS-[A-Z]{3}$"}},
    "data_stores": {"type": "array", "items": {"type": "string"}},
    "health": {"type": "object", "required": ["liveness", "readiness"]},
    "slo": {"type": "string", "minLength": 1},
    "runbook": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "deny_by_default": {"const": true}
  }
}
