{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noosfera.invalid/schemas/module-manifest.schema.json",
  "title": "ModuleManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "responsibility", "inputs", "outputs", "buses"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Z]{3}-[0-9]{2}$"},
    "name": {"type": "string", "minLength": 1},
    "responsibility": {"type": "string", "minLength": 1},
    "inputs": {"type": "array", "items": {"type": "string"}},
    "outputs": {"type": "array", "items": {"type": "string"}},
    "buses": {"type": "array", "items": {"pattern": "^BUS-[A-Z]{3}$"}, "minItems": 1}
  }
}
