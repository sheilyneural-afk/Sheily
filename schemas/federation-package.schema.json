{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noosfera.invalid/schemas/federation-package.schema.json",
  "title": "FederationPackage",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "source_node", "destination_node", "protocol", "created_at", "expires_at", "payload_hash", "content_type", "hop_limit", "signature"],
  "properties": {
    "id": {"$ref": "common.schema.json#/$defs/urn"},
    "source_node": {"$ref": "common.schema.json#/$defs/urn"},
    "destination_node": {"$ref": "common.schema.json#/$defs/urn"},
    "protocol": {"type": "string", "minLength": 1},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "expires_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "payload_hash": {"$ref": "common.schema.json#/$defs/sha256"},
    "content_type": {"type": "string", "minLength": 1},
    "hop_limit": {"type": "integer", "minimum": 0, "maximum": 128},
    "previous_hops": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/urn"}},
    "signature": {"$ref": "common.schema.json#/$defs/signature"}
  }
}
