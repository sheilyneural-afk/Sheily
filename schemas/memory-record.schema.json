{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noosfera.invalid/schemas/memory-record.schema.json",
  "title": "MemoryRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "owner", "kind", "classification", "epistemic_status", "purpose", "content_hash", "created_at", "retention_policy"],
  "properties": {
    "id": {"$ref": "common.schema.json#/$defs/urn"},
    "owner": {"$ref": "common.schema.json#/$defs/urn"},
    "kind": {"enum": ["working", "personal", "institutional", "knowledge", "provenance", "archive", "secret"]},
    "classification": {"enum": ["public", "community", "protected", "intimate", "cognitive", "existential"]},
    "epistemic_status": {"type": "string"},
    "purpose": {"type": "string", "minLength": 1},
    "content_hash": {"$ref": "common.schema.json#/$defs/sha256"},
    "content_location": {"type": "string"},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "retention_policy": {"type": "string", "minLength": 1},
    "provenance": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/urn"}}
  }
}
