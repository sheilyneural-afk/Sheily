{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noosfera.invalid/schemas/audit-event.schema.json",
  "title": "AuditEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "trace_id", "event_type", "actor", "object_hash", "occurred_at", "classification", "previous_receipt_hash", "signature"],
  "properties": {
    "id": {"$ref": "common.schema.json#/$defs/urn"},
    "trace_id": {"$ref": "common.schema.json#/$defs/urn"},
    "event_type": {"type": "string", "minLength": 1},
    "actor": {"$ref": "common.schema.json#/$defs/urn"},
    "object_hash": {"$ref": "common.schema.json#/$defs/sha256"},
    "occurred_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "classification": {"enum": ["public", "community", "protected", "intimate", "cognitive", "existential"]},
    "previous_receipt_hash": {"$ref": "common.schema.json#/$defs/sha256"},
    "signature": {"$ref": "common.schema.json#/$defs/signature"}
  }
}
