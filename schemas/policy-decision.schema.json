{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noosfera.invalid/schemas/policy-decision.schema.json",
  "title": "PolicyDecision",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "policy_id", "policy_version", "allow", "reasons", "obligations", "input_hash", "decided_at"],
  "properties": {
    "id": {"$ref": "common.schema.json#/$defs/urn"},
    "policy_id": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string", "minLength": 1},
    "allow": {"type": "boolean"},
    "reasons": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "obligations": {"type": "array", "items": {"type": "string"}},
    "input_hash": {"$ref": "common.schema.json#/$defs/sha256"},
    "decided_at": {"$ref": "common.schema.json#/$defs/timestamp"}
  }
}
